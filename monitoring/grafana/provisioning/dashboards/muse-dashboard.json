      "panels": [],
      "title": "Service overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Measures: How many mentors currently have an open chat connection (/ws).\nHelps you: Confirm someone is in a live session and correlate connection count with turns or latency spikes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(muse_active_websocket_connections)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Active WebSockets",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Measures: Failed or quota-blocked Gemini calls per minute (quota + error combined, conversation + whisper).\nHelps you: Top-level health check \u2014 should stay at zero. Non-zero means check API keys, quota, or orchestrator logs.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "suffix": " /min"
          },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.6
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(muse_gemini_calls_total{outcome!=\"ok\"}[$__rate_interval])) * 60",
          "legendFormat": "errors/min",
          "refId": "A"
        }
      ],
      "title": "Gemini errors per minute",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 102,
      "panels": [],
      "title": "LLM usage",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "How many tokens Gemini billed in the time range (top-right picker). Prompt (input) = text sent into the model. Completion (output) = text the model wrote back, including thinking tokens. Total = Prompt + Completion for that agent, not a third kind of token. Conversation = mentee replies; Whisper = coaching notes. Footer sums all rows.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "right",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false,
            "inspect": false
          },
          "decimals": 0,
          "min": 0,
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Agent"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "conversation": {
                        "index": 0,
                        "text": "Conversation (mentee)"
                      },
                      "whisper": {
                        "index": 1,
                        "text": "Whisper (coach)"
                      },
                      "grounding_judge": {
                        "index": 2,
                        "text": "Grounding judge"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 22,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "enablePagination": false,
          "fields": [
            "Prompt (input)",
            "Completion (output)",
            "Total"
          ],
          "reducer": [
            "sum"
          ],
          "show": true
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Total"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (agent, kind) (increase(muse_llm_tokens_total[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Token usage by agent",
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "kind",
            "emptyValue": "zero",
            "rowField": "agent",
            "valueField": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "agent\\kind": 0,
              "prompt": 1,
              "completion": 2,
              "Total": 3
            },
            "renameByName": {
              "agent\\kind": "Agent",
              "prompt": "Prompt (input)",
              "completion": "Completion (output)"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Total",
            "binary": {
              "left": "Prompt (input)",
              "operator": "+",
              "right": "Completion (output)"
            },
            "mode": "binary",
            "reduce": {
              "reducer": "sum"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 103,
      "panels": [],
      "title": "Agent performance",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "How long Gemini attempts took in the time range (top-right picker), excluding quota/429. p50 = typical attempt. p95 = slow tail. Conversation is time-to-last streamed token (model + sending chunks to the browser). Whisper is the coaching-note API call only (grounding runs after and is not included). These are per attempt, not a full chat turn; retries count separately. Percentiles are interpolated from histogram buckets. Attempts = how many observations the percentiles are based on.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "right",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false,
            "inspect": false
          },
          "decimals": 2,
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Agent"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "conversation": {
                        "index": 0,
                        "text": "Conversation (mentee)"
                      },
                      "whisper": {
                        "index": 1,
                        "text": "Whisper (coach)"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Attempts"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 31,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "enablePagination": false,
          "fields": [],
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "p95"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le, agent) (increase(muse_agent_latency_seconds_bucket{outcome!=\"quota\"}[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, agent) (increase(muse_agent_latency_seconds_bucket{outcome!=\"quota\"}[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (agent) (increase(muse_agent_latency_seconds_count{outcome!=\"quota\"}[$__range]))",
          "format": "table",
          "instant": true,
          "legendFormat": "attempts",
          "refId": "C"
        }
      ],
      "title": "Agent latency",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "agent",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            },
            "indexByName": {
              "agent": 0,
              "Value #C": 1,
              "Value #A": 2,
              "Value #B": 3
            },
            "renameByName": {
              "agent": "Agent",
              "Value #A": "p50",
              "Value #B": "p95",
              "Value #C": "Attempts"
            }
          }
        }
      ],
      "type": "table"
    },
